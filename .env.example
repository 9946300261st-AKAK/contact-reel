# ContactReel server configuration
PORT=8080
BASE_PATH=/

# Optional PostgreSQL connection used by the Drizzle schema/migration tooling.
DATABASE_URL=

# Optional direct Supabase fallback for independent non-Replit clones.
# Replit deployments should use the attached Supabase connector instead.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_IMAGE_BUCKET=reel-images
SUPABASE_RENDER_BUCKET=reel-renders

# If set, POST /api/v1/render and cancellation require:
# Authorization: Bearer <API_KEY_SECRET>
API_KEY_SECRET=

# Optional HMAC secret for X-ContactReel-Signature webhook verification.
WEBHOOK_SECRET=

# Maximum render/cancellation requests per client IP in a rolling minute.
RENDER_RATE_LIMIT_PER_MINUTE=30
