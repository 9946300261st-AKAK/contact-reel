# ContactReel server configuration
# The API is safe to run without Supabase for local previews. When configured,
# sourceId values can resolve from Supabase Storage and completed MP4s are uploaded there.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_IMAGE_BUCKET=reel-images
SUPABASE_RENDER_BUCKET=reel-renders

# If set, POST /api/v1/render and cancellation require Authorization: Bearer <value>.
API_KEY_SECRET=
WEBHOOK_SECRET=

# Optional deployment metadata and resource guards.
PUBLIC_BASE_URL=
MAX_RENDER_DURATION=1200
MAX_SOURCE_IMAGES=100
RENDER_RATE_LIMIT_PER_MINUTE=30